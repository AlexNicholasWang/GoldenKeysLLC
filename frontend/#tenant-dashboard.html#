<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/png" href="assets/logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/styles.css">
  <script src="js/config.js"></script>
  <title>Tenant Dashboard — Golden Keys LLC</title>
</head>
<body class="app-body" onload="fetchTenantData()">

  <div class="app-bar">
    <a class="brand" href="index.html">
      <img src="assets/logo.png" alt="Golden Keys LLC logo" style="height:38px">
      <span class="brand-name">Golden Keys<small>Tenant</small></span>
    </a>
    <div class="spacer"></div>
    <a class="btn btn-outline" href="index.html">Go Home</a>
  </div>

  <main class="app-main">
    <div class="rule-label align-left">Tenant dashboard</div>
    <h2 id="welcomeMessage"></h2>
    <p class="app-sub">Your lease details, kept current by your landlord.</p>

    <h3>Your lease</h3>
    <div class="panel table-wrap">
      <table id="tenantTable" class="data-table" style="display: none;">
        <thead>
          <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Address</th>
            <th>Rent ($)</th>
            <th>Day of Month Due</th>
            <th>Next Due Date</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td id="firstName"></td>
            <td id="lastName"></td>
            <td id="email"></td>
            <td id="address"></td>
            <td id="rent"></td>
            <td id="day"></td>
            <td id="date"></td>
          </tr>
        </tbody>
      </table>
    </div>

    <p id="status" class="status-line"></p>
  </main>

  <script>
        async function fetchTenantData() {
            const statusElem = document.getElementById("status");
            const welcomeElem = document.getElementById("welcomeMessage");
            const code = sessionStorage.getItem("code");
            const ssoToken = sessionStorage.getItem("ssoToken");

            if (!code || !ssoToken) {
                statusElem.textContent = "Error: Missing 'code' or 'ssoToken' in sessionStorage.";
                return;
            }

            try {
                // Adjust host/port if your Uvicorn server uses a different address
                const response = await fetch(API_BASE + "/api/get-tenant-data", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        code: code,
                        token: ssoToken
                    })
                });

                if (!response.ok) {
                    const errorData = await response.json();
                    statusElem.textContent = "Error: " + (errorData.detail || "Failed to fetch data.");
                    return;
                }

                const data = await response.json();
                const firstName = data.first_name || "";
                const lastName = data.last_name || "";

                // Display welcome heading
                welcomeElem.textContent = `Welcome back ${firstName} ${lastName}`.trim();

                // Populate table cells in requested order
                document.getElementById("firstName").textContent = firstName;
                document.getElementById("lastName").textContent = lastName;
                document.getElementById("email").textContent = data.email || "";
                document.getElementById("address").textContent = data.address || "";
                document.getElementById("rent").textContent = data.rent || "";
                document.getElementById("day").textContent = data.day || "";
                document.getElementById("date").textContent = data.date || "";

                // Show table
                document.getElementById("tenantTable").style.display = "table";
            } catch (err) {
                statusElem.textContent = "Network error: Unable to connect to server.";
            }
        }
    </script>
</body>
</html>
